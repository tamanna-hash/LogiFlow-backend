# ────────────────────────────────────────────────────────────
# LogiFlow Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/logiflow?sslmode=require

# ── JWT ───────────────────────────────────────────────────────
# Minimum 32 characters each. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_char_random_string_minimum_here_abcdefghijklmnopqrstuvwx
JWT_REFRESH_SECRET=replace_with_another_64_char_random_string_minimum_abcdefghijklmnopqrstu
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Upstash Redis ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# 
# Localhost callback:
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
# 
# Production callback (Render):
# GOOGLE_CALLBACK_URL=https://logiflow-backend-ai0r.onrender.com/api/v1/auth/google/callback

# ── Cloudinary (avatar + delivery proof uploads) ─────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email provider ────────────────────────────────────────────
# EMAIL_PROVIDER=resend   → use Resend (default)
# EMAIL_PROVIDER=gmail    → use Gmail SMTP (App Password)
EMAIL_PROVIDER=resend

# ── Resend (used when EMAIL_PROVIDER=resend) ──────────────────
RESEND_API_KEY=re_your_resend_api_key
# Sandbox: onboarding@resend.dev (delivers only to your Resend account email)
# Production: noreply@yourdomain.com (verify domain in Resend dashboard first)
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Gmail SMTP (used when EMAIL_PROVIDER=gmail) ───────────────
# SMTP_USER: your Gmail address, e.g. yourapp@gmail.com
# SMTP_PASS: Gmail App Password (NOT your regular password)
#   Setup: Google Account → Security → 2-Step Verification → App passwords
#   Sending limits: ~500 emails/day via Gmail SMTP (free accounts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER=yourapp@gmail.com
# SMTP_PASS=your_16_char_app_password

# ── bKash (existing integration — do not remove) ─────────────
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
# This must point to the BACKEND callback URL — NOT the frontend
# 
# Development (localhost):
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback
# 
# Production (Render):
# BKASH_CALLBACK_URL=https://logiflow-backend-ai0r.onrender.com/api/v1/payments/bkash/callback

# ── Stripe (optional — server starts without it) ─────────────
# Sign up at https://dashboard.stripe.com/register
# Test keys start with sk_test_ and pk_test_
# Live keys start with sk_live_ and pk_live_ — use ONLY for production
# STRIPE_SECRET_KEY: server-side only, NEVER expose to browser
# STRIPE_PUBLISHABLE_KEY: safe for frontend (not needed server-side)
# STRIPE_WEBHOOK_SECRET: from Stripe Dashboard → Webhooks → signing secret
#   Local testing: install Stripe CLI → stripe listen --forward-to localhost:3000/api/v1/payments/stripe/webhook
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ── Application URLs ──────────────────────────────────────────
# FRONTEND_URL is used for:
#   1. CORS origin whitelist
#   2. bKash redirect after payment callback
#   3. Stripe success/cancel redirect URLs
# 
# Development (localhost):
FRONTEND_URL=http://localhost:3000
# 
# Production (Vercel):
# FRONTEND_URL=https://logiflow-hash.vercel.app

# ── Business rules ────────────────────────────────────────────
MAX_DELIVERY_ATTEMPTS=3

# ── Demo mode (optional) ──────────────────────────────────────
# When set, any user whose email ends with @<DEMO_DOMAIN> is restricted
# to read-only access. All mutating requests are blocked with HTTP 403.
# Set to the demo email domain, e.g:  DEMO_DOMAIN=demo.logiflow.app
# Leave commented out (or empty) to disable demo-mode enforcement.
# DEMO_DOMAIN=demo.logiflow.app
